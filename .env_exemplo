# Configurações do Banco de Dados PostgreSQL (Container Docker)
POSTGRES_DB=blogdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass_secure_123

# Configurações de Conexão da API com o Banco de Dados (Spring Boot)
# O host "db" refere-se ao nome do serviço PostgreSQL dentro da rede do Docker Compose
DB_URL=jdbc:postgresql://db:5432/blogdb
DB_USERNAME=postgres
DB_PASSWORD=postgres_pass_secure_123
